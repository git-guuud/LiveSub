# Copy to .env in this directory. .env is not committed.
# npm start in relay/ loads this file when it exists.
# The AES key stays in relay/data/aes.key. It is not an environment variable.

# 0G Compute Router key (sk-). Live transcription and reasoning stay off until this is set.
OG_API_KEY=

# Galileo testnet storage. Uploads stay off until all three are set.
# OG_KV_NODE is a storage node that can read the stream, not the indexer URL.
# OG_STORAGE_NETWORK=mainnet switches the RPC, indexer, and flow contract.
# Mainnet still needs a mainnet key, a mainnet stream, and a KV node watching that stream.
OG_STORAGE_PRIVATE_KEY=
OG_KV_STREAM_ID=
OG_KV_NODE=
# OG_STORAGE_NETWORK=galileo

# Optional. Defaults are 8787, 0.0.0.0, relay/data, and the badge name seer.
# A name saved on the phone replaces this one.
# PORT=8787
# HOST=0.0.0.0
# LIVESUB_DATA=relay/data
# LIVESUB_BADGE_NAME=seer
